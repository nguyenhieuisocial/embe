EMBE_ROOT=C:/EmBe
TZ=Asia/Ho_Chi_Minh
PUID=1000
PGID=1000

BABYBUDDY_PORT=8000
MEMOS_PORT=5230
GROCY_PORT=9283
NODE_RED_PORT=1880
UPTIME_KUMA_PORT=3001
IMMICH_PORT=2283
MQTT_PORT=1883
HOME_ASSISTANT_PORT=8123

# Must point to a dedicated non-system drive before importing real media.
MEDIA_LOCATION=D:/EmBeMedia/immich
IMMICH_EXTERNAL_LIBRARY_PATH=D:/EmBeMedia/archive
IMMICH_DB_DATA_LOCATION=C:/EmBe/data/appdata/immich-postgres

# Required only for the media profile. Put the real value in an ignored
# core.env file or inject it from SOPS; never commit it.
# IMMICH_DB_PASSWORD=
