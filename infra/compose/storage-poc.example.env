# Both gates stay false in committed configuration.
EMBE_STORAGE_POC_ENABLED=false
EMBE_TELEGRAM_POC_ENABLED=false

# Generate values at runtime; never commit them.
EMBE_STORAGE_POC_API_KEY=
EMBE_STORAGE_POC_MASTER_KEY_B64=
EMBE_STORAGE_POC_TENANT_ID=storage-poc-lab
EMBE_STORAGE_POC_OWNER_ID=storage-poc-operator

# Dedicated Premium lab account only. For Docker Compose, use the container
# path /data/storage-poc/telegram-lab (host file: C:\EmBe\data\storage-poc\telegram-lab.session).
EMBE_TELEGRAM_DEDICATED_ACCOUNT_ASSERTION=
EMBE_TELEGRAM_SESSION_STORAGE_ASSERTION=
EMBE_TELEGRAM_EXPECTED_USER_ID=
EMBE_TELEGRAM_API_ID=
EMBE_TELEGRAM_API_HASH=
EMBE_TELEGRAM_SESSION_PATH=
EMBE_TELEGRAM_SHARD_IDS=

# Optional disposable R2 lab bucket.
EMBE_R2_ACCOUNT_ID=
EMBE_R2_POC_BUCKET=
EMBE_R2_ACCESS_KEY_ID=
EMBE_R2_SECRET_ACCESS_KEY=

# Optional disposable S3 lab bucket.
EMBE_S3_POC_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
